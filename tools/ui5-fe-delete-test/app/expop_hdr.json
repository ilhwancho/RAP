{
 "_version": "1.49.0",
 "sap.app": {
  "id": "zlrtest",
  "type": "application",
  "title": "t",
  "applicationVersion": {
   "version": "1.0.0"
  },
  "dataSources": {
   "mainService": {
    "uri": "/sap/opu/odata4/sap/zui_cih_salesorder_o4/srvd/sap/zui_cih_salesorder/0001/",
    "type": "OData",
    "settings": {
     "odataVersion": "4.0",
     "annotations": [
      "annotation"
     ]
    }
   },
   "annotation": {
    "type": "ODataAnnotation",
    "uri": "expop_anno.xml",
    "settings": {
     "localUri": "expop_anno.xml"
    }
   }
  }
 },
 "sap.ui": {
  "technology": "UI5"
 },
 "sap.ui5": {
  "dependencies": {
   "libs": {
    "sap.fe.templates": {}
   }
  },
  "models": {
   "": {
    "dataSource": "mainService",
    "preload": true,
    "settings": {
     "operationMode": "Server",
     "autoExpandSelect": true,
     "earlyRequests": true
    }
   },
   "i18n": {
    "type": "sap.ui.model.resource.ResourceModel",
    "settings": {
     "bundleName": "zlrtest.i18n"
    }
   }
  },
  "routing": {
   "routes": [
    {
     "pattern": ":?query:",
     "name": "L",
     "target": "L"
    },
    {
     "pattern": "SalesOrder({key}):?query:",
     "name": "O",
     "target": "O"
    }
   ],
   "targets": {
    "L": {
     "type": "Component",
     "id": "L",
     "name": "sap.fe.templates.ListReport",
     "options": {
      "settings": {
       "contextPath": "/SalesOrder",
       "variantManagement": "None",
       "initialLoad": "Enabled",
       "navigation": {
        "SalesOrder": {
         "detail": {
          "route": "O"
         }
        }
       }
      }
     }
    },
    "O": {
     "type": "Component",
     "id": "O",
     "name": "sap.fe.templates.ObjectPage",
     "options": {
      "settings": {
       "contextPath": "/SalesOrder",
       "controlConfiguration": {
        "_Item/@com.sap.vocabularies.UI.v1.LineItem": {
         "columns": {
          "NoHeaderKey": {
           "template": "zlrtest.ext.OS_C_OS_QTY",
           "properties": [
            "Quantity"
           ],
           "position": {
            "placement": "End"
           }
          },
          "I18nHeader": {
           "header": "{i18n>DateCheckLabel}",
           "template": "zlrtest.ext.OS_C_OS_QTY",
           "properties": [
            "Quantity"
           ],
           "position": {
            "placement": "End"
           }
          },
          "I18nMissing": {
           "header": "{i18n>NoSuchKey}",
           "template": "zlrtest.ext.OS_C_OS_QTY",
           "properties": [
            "Quantity"
           ],
           "position": {
            "placement": "End"
           }
          },
          "PlainHeader": {
           "header": "Date Check",
           "template": "zlrtest.ext.OS_C_OS_QTY",
           "properties": [
            "Quantity"
           ],
           "position": {
            "placement": "End"
           }
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}