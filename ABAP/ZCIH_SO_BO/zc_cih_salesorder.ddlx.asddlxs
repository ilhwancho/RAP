                           { type: #FOR_ACTION, dataAction: 'rejectOrder', label: 'Reject' } ],
         identification: [ { position: 10 },
                           { type: #FOR_ACTION, dataAction: 'acceptOrder', label: 'Accept' },
                           { type: #FOR_ACTION, dataAction: 'rejectOrder', label: 'Reject' } ],
         selectionField: [ { position: 10 } ] }
